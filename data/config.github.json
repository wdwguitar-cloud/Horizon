        "enabled": true,
        "category": "website-growth",
        "profile": "ai-creator"
      },
      {
        "name": "跨境风向与文化出海",
        "url": "https://news.google.com/rss/search?q=%E8%B7%A8%E5%A2%83%E9%A3%8E%E5%90%91%20OR%20%E5%95%86%E5%93%81%E6%B5%81%E8%A1%8C%E8%B6%8B%E5%8A%BF%20OR%20%E4%B8%AD%E5%9B%BD%E5%95%86%E5%93%81%E5%87%BA%E6%B5%B7%20OR%20%E6%96%87%E5%8C%96%E5%87%BA%E6%B5%B7&hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "global-growth",
        "profile": "ai-creator"
      },
      {
        "name": "AI 电商与独立站增长",
        "url": "https://news.google.com/rss/search?q=AI%20ecommerce%20OR%20AI%E7%8B%AC%E7%AB%8B%E7%AB%99%20OR%20AI%20shopify%20OR%20AI%E5%95%86%E5%93%81%E8%B6%8B%E5%8A%BF&hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "global-growth",
        "profile": "ai-creator"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "artificial",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "ai-news",
          "profile": "tech-news"
        },
        {
          "subreddit": "ChatGPT",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "creator-growth",
          "profile": "ai-creator"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 15,
          "category": "ai-news",
          "profile": "tech-news"
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "agent",
        "workflow",
        "automation",
        "video",
        "content",
        "website",
        "commerce"
      ],
      "min_stars": 20,
      "max_items": 15,
      "category": "ai-tools",
      "profile": "ai-creator"
    }
  },
  "collection": {
    "time_window_hours": 60
  },
  "digest": {
    "max_items": 12,
    "profile_order": [
      "ai-creator",
      "tech-news",
      "tech-blog"
    ],
    "category_groups": {
      "practical_tools": {
        "name": "工具与工作流",
        "limit": 4,
        "categories": [
          "ai-tools",
          "automation",
          "website-growth"
        ]
      },
      "creator_growth": {
        "name": "内容与出海",
        "limit": 5,
        "categories": [
          "creator-growth",
          "global-growth"
        ]
      },
      "core_ai": {
        "name": "AI 核心动态",
        "limit": 4,
        "categories": [
          "ai-news",
          "ai-community",
          "ai-agents"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
