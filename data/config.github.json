{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.2,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "ai-creator": {
        "threshold": 4.4,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "langgenius",
        "repo": "dify",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "n8n-io",
        "repo": "n8n",
        "enabled": true,
        "category": "automation",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "FlowiseAI",
        "repo": "Flowise",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "langflow-ai",
        "repo": "langflow",
        "enabled": true,
        "category": "automation",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "autogen",
        "enabled": true,
        "category": "ai-agents",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 24,
      "min_score": 110,
      "category": "ai-community",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      },
      {
        "name": "AI 行业总览",
        "url": "https://news.google.com/rss/search?q=AI%20OR%20%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%20OR%20ChatGPT%20OR%20Claude%20OR%20Gemini%20OR%20DeepSeek%20OR%20AI%20Agent&hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "ai-news",
        "profile": "tech-news"
      },
      {
        "name": "AI 工具与效率产品",
        "url": "https://news.google.com/rss/search?q=AI%20tools%20OR%20AI%E5%B7%A5%E5%85%B7%20OR%20AI%20productivity%20OR%20AI%20workflow&hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
